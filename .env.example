# FTP or explicit FTPS connection
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USERNAME=username
FTP_PASSWORD=replace-me
FTP_PROTOCOL=ftp
FTP_PASSIVE_MODE=true
FTP_ROOT_PATH=/
FTP_TIMEOUT_SECONDS=30
FTP_MAX_RETRIES=5
FTP_REQUEST_DELAY_MS=250
FTP_BATCH_SIZE=500
FTP_TLS_VERIFY=true

# Persistent paths inside the containers
DATABASE_URL=sqlite:////data/ftp-index.db
LOG_DIRECTORY=/logs
CONFIG_DIRECTORY=/config

# Six-field values are not supported; use standard five-field cron syntax.
# Leave blank to disable automatic scans.
SCAN_SCHEDULE=0 */6 * * *

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_WORKERS=2
SESSION_SECRET=generate-a-long-random-value
ALLOWED_HOSTS=*
SECURE_COOKIES=false

# Optional local administrator login. Leave ADMIN_PASSWORD blank to disable login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Interface and indexing options
DEFAULT_RESULTS_PER_PAGE=50
MAX_RESULTS_PER_PAGE=200
ENABLE_DIRECT_FTP_LINKS=false
MUSIC_FILENAME_PARSING=true
LOG_RETENTION_DAYS=30
